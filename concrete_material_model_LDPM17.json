{
  "concrete_material_model": {
    "model_id": "CMM0001",
    "model_version": "1.0.0",
    "model_name": "Lattice Discrete Particle Model",
    "model_acronym": "LDPM",
    "model_variant": "LDPM17",
    "model_family": [
      "discrete",
      "mesoscale"
    ],
    "material_representation": {
      "type": "discrete_mesostructure",
      "discretization_relationship": "intrinsic",
      "generation_method": "Stochastic placement of coarse-aggregate particles followed by Delaunay tetrahedralization and generation of polyhedral cells and triangular facets; the particular particle arrangement and connectivity are simulation-specific."
    },
    "strain_definition": {
      "type": "facet_strain",
      "components": [
        "normal",
        "tangential_L",
        "tangential_M"
      ],
      "description": "Normal and two tangential facet strain components obtained by projecting the relative displacement jump between adjacent rigid cells onto the local facet coordinate system and normalizing by the associated lattice length. See the model's primary formulation reference for precise definitions."
    },
    "stress_definition": {
      "type": "facet_traction",
      "components": [
        "normal",
        "tangential_L",
        "tangential_M"
      ],
      "description": "Normal and two tangential facet tractions associated with the local facet strain components. The precise constitutive relations are defined by the cited LDPM17 formulation."
    },
    "physical_mechanisms": [
      "elasticity",
      "tensile_fracture",
      "compressive_inelasticity",
      "frictional_shear"
    ],
    "mix_design": {
      "parameters": [
        {
          "parameter_id": "MIX0001",
          "name": "cement_content",
          "symbol": "c",
          "unit": "kg/m^3",
          "definition": "Cement content per unit volume of concrete."
        },
        {
          "parameter_id": "MIX0002",
